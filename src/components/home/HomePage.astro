---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta      — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import GameDataStrip from '~/components/home/GameDataStrip.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const shared = ui.shared as Record<string, string>;

const recent = await getRecentEntries(locale, 6);

const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
const updates = home.updates ?? { title: 'Recent Updates' };
const start = home.start ?? { cards: [] };
const popular = home.popular ?? { title: 'Trending Now', quickLinks: [] };
const explore = home.explore ?? { modules: [] };
const closingCta = home.closingCta ?? {};
const gameStats = Array.isArray(home.gameStats)
  ? home.gameStats
  : [
      { label: 'Release Date', value: 'RELEASE_DATE', icon: 'lucide:calendar-days' },
      { label: 'Platforms', value: 'PLATFORM', icon: 'lucide:monitor-smartphone' },
      { label: 'Developer', value: 'DEVELOPER', icon: 'lucide:building-2' },
      { label: 'Genre', value: 'GENRE', icon: 'lucide:gamepad-2' },
    ];

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  titleSuffix=""
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section class="relative left-1/2 flex min-h-[52vh] w-screen -translate-x-1/2 items-center overflow-hidden bg-muted/25 bg-cover bg-center md:min-h-[68vh]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-b from-background/35 via-background/60 to-background" />

    <div class="relative mx-auto flex w-full max-w-7xl items-center px-4 py-16 md:py-24">
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{hero.badge}</p>
      <h1
        class="mt-3 max-w-3xl bg-gradient-to-r from-foreground to-foreground/60 bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{hero.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          hero.ctaPrimary && hero.ctaPrimaryHref && (
            <a href={localizePath(hero.ctaPrimaryHref, locale)} class="btn-primary">
              <Icon name="lucide:play" class="mr-2 h-4 w-4" />
              {hero.ctaPrimary}
            </a>
          )
        }
        {
          hero.ctaSecondary && hero.ctaSecondaryHref && (
            <a href={localizePath(hero.ctaSecondaryHref, locale)} class="btn-outline">
              {hero.ctaSecondary}
            </a>
          )
        }
      </div>
      </div>
      <div class="hidden w-[44%] max-w-xl lg:block">
        <div class="overflow-hidden rounded-lg border border-brand/40 bg-background/70 shadow-2xl shadow-background/60">
          <iframe
            class="aspect-video w-full"
            src="https://www.youtube-nocookie.com/embed/effB-VacVvE?rel=0&modestbranding=1"
            title="GAME_NAME Official Trailer"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <GameDataStrip stats={gameStats} />


  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a href={localizePath('/guides', locale)} class="text-sm text-foreground hover:text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">
                      {parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {trendingLinks.length > 0 && (
        <aside>
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{popular.badge}</p>
          <h2 class="mt-1 text-2xl font-bold">{popular.title}</h2>
          <ul class="mt-4 space-y-2">
            {trendingLinks.map((link: QuickLink) => {
              const href = trendingHref(link);
              const label = trendingLabel(link);
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium transition hover:border-nav/50"
                    >
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </a>
                  ) : (
                    <div class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl font-bold">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="rounded-xl border bg-card p-8 text-center md:p-12">
          <h2 class="text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a href={localizePath('/guides', locale)} class="btn-primary">
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
