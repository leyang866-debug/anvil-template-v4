---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { articles, articleBySlug, expansion } from '~/data/articles';
export function getStaticPaths() { return articles.map((entry) => ({ params: { slug: entry.slug } })); }
const article = articleBySlug.get(Astro.params.slug ?? '');
if (!article) return new Response('Not Found', { status: 404 });
---
<BaseLayout title={article.title} description={article.description} locale="en" article>
  <header class="home-nav"><div class="site-shell flex min-h-16 items-center justify-between gap-5"><a href="/" class="display text-sm font-bold tracking-[.18em] text-orange-200">GAME <span class="text-red-500">//</span> FIELD MANUAL</a><nav class="hidden items-center gap-5 text-xs uppercase tracking-widest text-stone-300 md:flex"><a href="/beginner-guide">Start here</a><a href="/characters">Characters</a><a href="/weapons">Weapons</a><a href="/maps">Maps</a></nav><details class="language-menu"><summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300">English ▾</summary><div class="language-popover"><a href={`/${article.slug}`}>EN</a><a href={`/ru/${article.slug}`}>RU</a><a href={`/de/${article.slug}`}>DE</a><a href={`/ja/${article.slug}`}>JA</a></div></details></div></header>
  <main class="site-shell article-layout py-12"><article class="panel article-body p-6 md:p-10"><p class="data mb-4 text-xs tracking-[.2em] text-orange-300">FIELD INTEL // {article.slug.toUpperCase()}</p><h1 class="display text-3xl font-bold leading-tight text-white md:text-5xl">{article.title}</h1><p class="mt-6 text-xl leading-8 text-stone-200">{article.intro}</p>{article.sections.map(([heading, body], index) => <section id={`chapter-${index + 1}`} class="article-section mt-10 scroll-mt-24"><h2 class="display border-l-4 border-red-600 pl-4 text-2xl font-semibold text-orange-200">{heading}</h2><p class="mt-4 leading-8 text-stone-200">{body}</p></section>)}<section class="article-section mt-10"><h2 class="display border-l-4 border-red-600 pl-4 text-2xl font-semibold text-orange-200">Practical guidance</h2><p class="mt-4 leading-8 text-stone-300">{expansion(article)}</p></section><section class="mt-12 border-t border-border pt-7"><h2 class="display text-xl text-orange-200">Continue your run</h2><div class="mt-4 flex flex-wrap gap-3">{article.related.map((href) => <a class="btn-outline border-red-900/60 bg-black/20 hover:border-orange-400" href={href}>{href.slice(1).replaceAll('-', ' ')}</a>)}</div></section></article><aside class="article-nav"><div class="panel p-4"><p class="data text-xs tracking-widest text-orange-300">ON THIS PAGE</p><nav class="chapter-links mt-3">{article.sections.map(([heading], index) => <a href={`#chapter-${index + 1}`}><span class="data">0{index + 1}</span>{heading}</a>)}</nav><p class="data mt-6 text-xs tracking-widest text-orange-300">OTHER GUIDES</p><nav class="guide-links mt-3">{articles.slice(0, 6).map((entry) => <a href={`/${entry.slug}`} class={entry.slug === article.slug ? 'current' : ''}>{entry.title}</a>)}</nav></div></aside></main>
  <footer class="home-footer"><div class="site-shell py-8 text-center text-sm text-stone-400">Reusable game guide template · replace brand, content and official links.</div></footer>
</BaseLayout>
