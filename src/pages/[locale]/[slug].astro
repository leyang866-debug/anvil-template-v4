---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { isLocale, locales, defaultLocale } from '~/i18n/routing';
import { articleBySlug } from '~/data/articles';
export function getStaticPaths(){ return locales.filter((locale)=>locale!==defaultLocale).flatMap((locale)=>[...articleBySlug.keys()].map((slug)=>({params:{locale,slug}}))); }
const locale=Astro.params.locale ?? ''; const article=articleBySlug.get(Astro.params.slug ?? '');
if (!isLocale(locale) || locale===defaultLocale || !article) return new Response('Not Found',{status:404});
---
<BaseLayout title={article.title} description={article.description} locale={locale} article><header class="home-nav"><div class="site-shell flex min-h-16 items-center justify-between"><a href={`/${locale}/`} class="display text-sm font-bold tracking-widest text-orange-200">GAME // FIELD MANUAL</a><details class="language-menu"><summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300">{locale.toUpperCase()} ▾</summary><div class="language-popover"><a href={`/${article.slug}`}>EN</a><a href={`/ru/${article.slug}`}>RU</a><a href={`/de/${article.slug}`}>DE</a><a href={`/ja/${article.slug}`}>JA</a></div></details></div></header><main class="site-shell article-layout py-12"><article class="panel article-body p-6 md:p-10"><p class="data mb-4 text-xs tracking-[.2em] text-orange-300">FIELD INTEL // {article.slug.toUpperCase()}</p><h1 class="display text-3xl font-bold leading-tight text-white md:text-5xl">{article.title}</h1><p class="mt-6 text-xl leading-8 text-stone-200">{article.intro}</p>{article.sections.map(([heading,body])=><section class="article-section mt-10"><h2 class="display border-l-4 border-red-600 pl-4 text-2xl font-semibold text-orange-200">{heading}</h2><p class="mt-4 leading-8 text-stone-200">{body}</p></section>)}</article><aside class="article-nav"><div class="panel p-4"><p class="data text-xs tracking-widest text-orange-300">OTHER GUIDES</p>{[...articleBySlug.values()].slice(0,6).map((entry)=><a class="guide-links block py-2" href={`/${locale}/${entry.slug}`}>{entry.title}</a>)}</div></aside></main><footer class="home-footer"><div class="site-shell py-8 text-center text-sm text-stone-400">Reusable game guide template · replace brand, content and official links.</div></footer></BaseLayout>
