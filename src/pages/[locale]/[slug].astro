---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { articles, articleBySlug, expansion } from '~/data/articles';
import { localizeArticle } from '~/data/localized';
import { isLocale, locales, defaultLocale } from '~/i18n/routing';
export function getStaticPaths() { return locales.filter((locale) => locale !== defaultLocale).flatMap((locale) => articles.map((article) => ({ params: { locale, slug: article.slug } }))); }
const locale = Astro.params.locale ?? '';
const slug = Astro.params.slug ?? '';
if (!isLocale(locale) || locale === defaultLocale) return new Response('Not Found', { status: 404 });
const source = articleBySlug.get(slug);
if (!source) return new Response('Not Found', { status: 404 });
const article = localizeArticle(source, locale);
const labels = article.labels;
---
<BaseLayout title={article.title} description={article.description} locale={locale} article>
  <header class="border-b border-border bg-black/50 backdrop-blur"><div class="site-shell flex min-h-16 items-center justify-between gap-5"><a href={`/${locale}/`} class="display text-sm font-bold tracking-widest text-orange-300">YAZS // {labels.guide.toUpperCase()}</a><nav class="hidden gap-4 text-sm md:flex"><a href={`/${locale}/beginner-guide`}>{labels.guide}</a><a href={`/${locale}/characters`}>Survivors</a><a href={`/${locale}/maps`}>Maps</a><a href={`/${locale}/achievements`}>Completion</a></nav><details class="language-menu"><summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300">{locale === 'ru' ? 'Русский' : locale === 'de' ? 'Deutsch' : '日本語'} ▾</summary><div class="language-popover"><a href={`/${article.slug}`}>EN</a><a href={`/ru/${article.slug}`}>RU</a><a href={`/de/${article.slug}`}>DE</a><a href={`/ja/${article.slug}`}>JA</a></div></details></div></header>
  <main class="site-shell article-layout py-12"><article class="panel article-body p-6 md:p-10"><p class="data mb-4 text-xs tracking-[.2em] text-orange-300">{labels.guide.toUpperCase()} // {article.slug.toUpperCase()}</p><h1 class="display text-3xl font-bold leading-tight text-white md:text-5xl">{article.title}</h1><p class="mt-6 text-xl leading-8 text-stone-200">{article.intro}</p>{article.sections.map(([heading, body], index) => <section id={`chapter-${index + 1}`} class="article-section mt-10 scroll-mt-24"><h2 class="display border-l-4 border-red-600 pl-4 text-2xl font-semibold text-orange-200">{heading}</h2><p class="mt-4 leading-8 text-stone-200">{body}</p></section>)}<section class="article-section mt-10"><h2 class="display border-l-4 border-red-600 pl-4 text-2xl font-semibold text-orange-200">{labels.practical}</h2><p class="mt-4 leading-8 text-stone-300">{article.practical}</p></section><section class="mt-12 border-t border-border pt-7"><h2 class="display text-xl text-orange-200">{labels.continue}</h2><div class="mt-4 flex flex-wrap gap-3"><a class="btn-primary" href={`/${locale}/`}>{labels.back}</a>{source.related.map((href) => <a class="btn-outline border-red-900/60 bg-black/20 hover:border-orange-400" href={`/${locale}${href}`}>{href.slice(1).replaceAll('-', ' ')}</a>)}</div></section></article><aside class="article-nav"><div class="nav-frame"><p class="data nav-kicker">{labels.quick}</p><h2 class="display nav-title">{article.title}</h2><nav class="chapter-links">{article.sections.map(([heading], index) => <a href={`#chapter-${index + 1}`}><span class="data">0{index + 1}</span>{heading}</a>)}</nav><div class="nav-bottom-corner" aria-hidden="true"></div></div></aside></main>
  <footer class="site-shell py-8 text-center text-sm text-stone-400">YAZS Wiki · {locale.toUpperCase()}</footer>
</BaseLayout>
