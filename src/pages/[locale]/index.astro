---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { isLocale, locales, defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { articles } from '~/data/articles';
export function getStaticPaths() { return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale ?? '';
if (!isLocale(locale) || locale === defaultLocale) return Astro.redirect('/');
const ui = getUi(locale);
const home = ui.home as { meta: { title: string; description: string }; hero: { badge: string; title: string; description: string; ctaPrimary: string; ctaSecondary: string } };
---
<BaseLayout title={home.meta.title} description={home.meta.description} locale={locale}>
  <header class="home-nav"><div class="site-shell flex min-h-16 items-center justify-between"><a href={`/${locale}/`} class="display text-sm font-bold tracking-widest text-orange-200">YAZS // FIELD MANUAL</a><details class="language-menu"><summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300">{locale === 'ru' ? 'Русский' : locale === 'de' ? 'Deutsch' : '日本語'} ▾</summary><div class="language-popover"><a href="/">EN</a><a href="/ru/">RU</a><a href="/de/">DE</a><a href="/ja/">JA</a></div></details></div></header>
  <main><section class="hero-home"><div class="hero-shade"></div><div class="site-shell relative flex min-h-[calc(100vh-4rem)] items-end pb-20 pt-24"><div class="max-w-3xl"><p class="data text-xs tracking-[.3em] text-orange-300">{home.hero.badge.toUpperCase()}</p><h1 class="display mt-5 text-5xl font-extrabold uppercase leading-[.9] text-white sm:text-7xl">{home.hero.title}</h1><p class="mt-7 max-w-2xl text-xl leading-8 text-stone-200">{home.hero.description}</p><div class="mt-8 flex flex-wrap gap-3"><a href={`/${locale}/beginner-guide`} class="btn-primary">{home.hero.ctaPrimary}</a><a href={`/${locale}/characters`} class="btn-outline border-orange-500/70 bg-black/30 text-white">{home.hero.ctaSecondary}</a></div><div class="data mt-10 grid grid-cols-2 gap-3 border-t border-white/20 pt-5 text-xs uppercase tracking-wider text-stone-300 sm:grid-cols-5"><span>1.0 live</span><span>9 Survivors</span><span>5 Maps</span><span>141 Achievements</span><span>28 Torments</span></div></div></div></section><section class="site-shell section-home"><div class="section-heading"><div><p class="data text-xs tracking-[.25em] text-orange-400">{home.hero.badge.toUpperCase()}</p><h2 class="display mt-2 text-4xl font-bold text-white">{home.hero.ctaSecondary}</h2></div></div><div class="start-grid">{articles.map((article) => <a class="media-card" href={`/${locale}/${article.slug}`}><span class="media-card-shade"></span><div class="relative"><p class="data text-[10px] tracking-[.2em] text-orange-300">{article.slug.toUpperCase()}</p><h3 class="display mt-2 text-2xl font-bold text-white">{article.title}</h3><p class="mt-2 max-w-xs text-sm leading-6 text-stone-200">{article.intro}</p><span class="mt-5 inline-block text-xs uppercase tracking-widest text-orange-300">{home.hero.ctaPrimary} →</span></div></a>)}</div></section></main><footer class="home-footer"><div class="site-shell py-10 text-sm text-stone-400">YAZS Wiki · {locale.toUpperCase()} · Fan-made guide</div></footer>
</BaseLayout>
