---
import HomePage from '~/components/home/HomePage.astro';
import { defaultLocale, isLocale, locales, type Locale } from '~/i18n/routing';
import { languageAlternates, homeUrl } from '~/lib/url';
import { websiteJsonLd } from '~/lib/seo';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? '';
if (!isLocale(localeParam) || localeParam === defaultLocale) return Astro.redirect('/');
const locale: Locale = localeParam;
const alternates = languageAlternates((loc) => homeUrl(loc), locales);
const jsonLd = [websiteJsonLd(locale)];
---

<HomePage locale={locale} alternates={alternates} jsonLd={jsonLd} />
