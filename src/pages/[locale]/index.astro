---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { defaultLocale, isLocale, locales } from '~/i18n/routing';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale ?? '';
if (!isLocale(locale) || locale === defaultLocale) return Astro.redirect('/');
const title = 'Game Guide Wiki — Builds, Characters and Secrets';
const description =
  'A reusable game guide homepage with beginner routes, builds, characters, maps, secrets and completion tracking.';
const startCards = [
  {
    href: '/beginner-guide',
    label: '01 / FIRST RUN',
    title: 'Beginner Guide',
    text: 'Learn the first repeatable route, upgrade rule and recovery plan.',
    image: '/images/hero-placeholder.svg',
  },
  {
    href: '/synergies',
    label: '02 / BUILD LAB',
    title: 'Builds & Synergies',
    text: 'Combine roles, upgrades and passives into a build with a clear job.',
    image: '/images/hero-placeholder.svg',
  },
  {
    href: '/potato',
    label: '03 / SECRET ITEM',
    title: 'Special Item Guide',
    text: 'Explain a distinctive item, secret trigger or collectible route.',
    image: '/images/hero-placeholder.svg',
  },
  {
    href: '/characters',
    label: '04 / ROSTER',
    title: 'Characters',
    text: 'Compare playable characters, roles, strengths and unlock routes.',
    image: '/images/hero-placeholder.svg',
  },
];
const drops = [
  {
    href: '/characters',
    title: 'Roster update',
    kicker: 'CHARACTERS',
    text: 'Show how new fighters fit into the squad and what role they perform.',
    image: '/images/hero-placeholder.svg',
  },
  {
    href: '/maps',
    title: 'Map hazards',
    kicker: 'NEW MAP',
    text: 'Document hazards, routes and safe movement lanes before raising difficulty.',
    image: '/images/hero-placeholder.svg',
  },
  {
    href: '/maps',
    title: 'Challenge mode',
    kicker: 'NEW MODE',
    text: 'Explain the objective, timing and build changes for a high-pressure mode.',
    image: '/images/hero-placeholder.svg',
  },
];
const survivors = [
  ['Vanguard', 'Rifle line', '/images/hero-placeholder.svg'],
  ['Bulwark', 'Heavy weapons', '/images/hero-placeholder.svg'],
  ['Tactician', 'Electric control', '/images/hero-placeholder.svg'],
  ['Stalker', 'Crit arrows', '/images/hero-placeholder.svg'],
  ['Phantom', 'Slash burst', '/images/hero-placeholder.svg'],
  ['Field Medic', 'Sustain', '/images/hero-placeholder.svg'],
  ['Incinerator', 'Elemental zones', '/images/hero-placeholder.svg'],
  ['Gadgeteer', 'Ability loops', '/images/hero-placeholder.svg'],
  ['Scout', 'Pet master', '/images/hero-placeholder.svg'],
];
---

<BaseLayout {title} {description} locale={locale}>
  <header class="home-nav">
    <div class="site-shell flex min-h-16 items-center justify-between gap-6">
      <a href="/" class="display text-sm font-bold tracking-[.18em] text-orange-200"
        >GAME <span class="text-red-500">//</span> FIELD MANUAL</a
      ><nav
        class="hidden items-center gap-6 text-xs uppercase tracking-widest text-stone-300 lg:flex"
      >
        <a href="/beginner-guide">Start Here</a><a href="/characters">Survivors</a><a
          href="/synergies">Builds</a
        ><a href="/maps">World</a><a href="/achievements">Completion</a>
      </nav><div class="flex items-center gap-4">
        <details class="language-menu">
          <summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300"
            >English ▾</summary
          ><div class="language-popover">
            <a href="/">EN</a><a href="/ru/">RU</a><a href="/de/">DE</a><a href="/ja/">JA</a>
          </div>
        </details><a href="/release-price" class="data hidden text-xs text-orange-300 sm:inline"
          >1.0 / AUG 20 2026</a
        >
      </div>
    </div>
  </header>
  <main>
    <section class="hero-home">
      <div class="hero-shade"></div><div
        class="site-shell relative flex min-h-[calc(100vh-4rem)] items-center pb-10 pt-20 md:pb-16 md:pt-20"
      >
        <div class="max-w-4xl">
          <p class="data text-xs tracking-[.3em] text-orange-300">
            FAN-MADE COMMUNITY WIKI / SURVIVOR-LIKE ROGUELITE
          </p><h1
            class="display mt-5 max-w-4xl text-5xl font-extrabold uppercase leading-[.9] text-white sm:text-7xl md:text-8xl"
          >
            YOUR<br /><span class="text-red-500">GAME TITLE</span>
          </h1><p class="mt-7 max-w-2xl text-lg leading-8 text-stone-200 md:text-xl">
            Replace this copy with your game overview, player goals, verified systems and current
            update details.
          </p><div class="mt-8 flex flex-wrap gap-3">
            <a href={`/${locale}/beginner-guide`} class="btn-primary">View beginner guide</a><a
              href="#start"
              class="btn-outline border-orange-500/70 bg-black/30 text-white">More guides</a
            >
          </div><div
            class="data mt-10 grid max-w-4xl grid-cols-2 gap-3 border-t border-white/20 pt-5 text-[11px] uppercase tracking-wider text-stone-300 sm:grid-cols-5"
          >
            <span>1.0 live</span><span>9 Survivors</span><span>5 Maps</span><span
              >100+ Achievements</span
            ><span>Challenge Trials</span>
          </div>
        </div>
      </div>
    </section>
    <section id="start" class="site-shell section-home">
      <div class="section-heading">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">START YOUR RUN</p><h2
            class="display mt-2 text-4xl font-bold text-white md:text-5xl"
          >
            Choose the problem you need solved.
          </h2>
        </div><p class="max-w-md text-stone-400">
          Each guide starts with the decision in front of you, then gives you the route, trade-off
          and next upgrade.
        </p>
      </div><div class="start-grid">
        {
          startCards.map((card) => (
            <a class="media-card" href={card.href}>
              <>
                <img src={card.image} alt="" loading="lazy" />
                <span class="media-card-shade" />
                <div class="relative">
                  <>
                    <p class="data text-[10px] tracking-[.2em] text-orange-300">{card.label}</p>
                    <h3 class="display mt-2 text-2xl font-bold text-white">{card.title}</h3>
                    <p class="mt-2 max-w-xs text-sm leading-6 text-stone-200">{card.text}</p>
                    <span class="mt-5 inline-block text-xs uppercase tracking-widest text-orange-300">
                      Open guide →
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="site-shell section-home">
      <div class="section-heading">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">VERSION 1.0 / THE DROP</p><h2
            class="display mt-2 text-4xl font-bold text-white md:text-5xl"
          >
            New threats. New routes.
          </h2>
        </div><a href="/release-price" class="text-sm text-orange-300">See release details →</a>
      </div><div class="drop-grid">
        {
          drops.map((drop) => (
            <a href={drop.href} class="drop-card">
              <>
                <img src={drop.image} alt="" loading="lazy" />
                <div class="drop-card-copy">
                  <>
                    <p class="data text-[10px] tracking-[.2em] text-orange-300">{drop.kicker}</p>
                    <h3 class="display mt-2 text-3xl font-bold text-white">{drop.title}</h3>
                    <p class="mt-3 text-sm leading-6 text-stone-200">{drop.text}</p>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="site-shell section-home home-article">
      <div class="home-article-grid">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">THE SHORT ANSWER</p><h2
            class="display mt-2 text-4xl font-bold text-white md:text-5xl"
          >
            What is This Game?
          </h2>
        </div><div class="space-y-5 text-base leading-8 text-stone-300">
          <p>
            This Game is a top-down survivor-like, bullet-heaven roguelite built around squad
            building. You move through a growing zombie horde while your Survivors fire
            automatically, collect XP, unlock weapons and abilities, and turn a fragile opening into
            a controlled run.
          </p><p>
            The important decision is not simply which character looks strongest. You start with a
            Leader, then recruit additional Survivors through SOS events. Their weapons, abilities,
            Items and cross-Survivor synergies determine how your squad handles crowds, elites,
            bosses and long endurance runs.
          </p><p>
            The 1.0 release adds a hub, story missions, relationships, a new Survivor, a new map and
            a new mode. That gives you two connected goals: learn the moment-to-moment run loop,
            then use the permanent progression and squad choices to open harder content.
          </p>
        </div>
      </div><div class="home-table-wrap">
        <table class="home-facts">
          <tbody
            ><tr
              ><th>Developer</th><td>Game Publisher</td><th>Genre</th><td
                >Survivor-like / Bullet Heaven / Roguelite / Zombie</td
              ></tr
            ><tr><th>Release</th><td>August 20, 2026</td><th>Price</th><td>$14.99</td></tr><tr
              ><th>Platforms</th><td>PC / PS4 / PS5 / Xbox One / Xbox Series</td><th>Multiplayer</th
              ><td>Single-player</td></tr
            ></tbody
          >
        </table>
      </div>
    </section>
    <section class="site-shell section-home">
      <div class="section-heading">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">HOW A RUN DEVELOPS</p><h2
            class="display mt-2 text-4xl font-bold text-white md:text-5xl"
          >
            From first pickup to full squad.
          </h2>
        </div><a href="/beginner-guide" class="text-sm text-orange-300">Read the beginner route →</a
        >
      </div><div class="run-stages">
        <div>
          <span class="data">01</span><h3 class="display">Choose a Leader</h3><p>
            Start with one Survivor and one weapon route. Vanguard, Bulwark and Tactician are clear
            entry points because their roles are easy to read while you learn movement and XP
            timing.
          </p>
        </div><div>
          <span class="data">02</span><h3 class="display">Stabilize the screen</h3><p>
            Use automatic attacks while you move. Keep space around the squad, collect XP without
            crossing a packed lane, and spend upgrades on a core weapon before scattering levels
            everywhere.
          </p>
        </div><div>
          <span class="data">03</span><h3 class="display">Recruit through SOS</h3><p>
            SOS events let you add the second and third Survivor. A new recruit is valuable when its
            weapon or ability covers a weakness in your current build, not simply because it is
            available.
          </p>
        </div><div>
          <span class="data">04</span><h3 class="display">Build the long game</h3><p>
            Items, Military Training and permanent progression turn successful runs into stronger
            starts. Once the core route is reliable, explore Endurance, Infinite, Hardcore and
            Gauntlet.
          </p>
        </div>
      </div>
    </section>
    <section class="roster-band">
      <div class="site-shell section-home">
        <div class="section-heading">
          <div>
            <p class="data text-xs tracking-[.25em] text-orange-400">THE SQUAD</p><h2
              class="display mt-2 text-4xl font-bold text-white md:text-5xl"
            >
              Nine ways to break the run open.
            </h2>
          </div><a href="/characters" class="text-sm text-orange-300">Compare all Survivors →</a>
        </div><div class="roster-strip">
          {
            survivors.map(([name, role, image]) => (
              <a href="/characters" class="roster-card">
                <>
                  <img src={image} alt={name} loading="lazy" />
                  <div>
                    <>
                      <h3 class="display text-lg font-bold text-white">{name}</h3>
                      <p class="data text-[10px] uppercase tracking-wider text-stone-400">{role}</p>
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
    <section id="trailer" class="site-shell section-home">
      <div class="trailer-panel">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">OFFICIAL MEDIA</p><h2
            class="display mt-2 text-4xl font-bold text-white"
          >
            See the squad loop in motion.
          </h2><p class="mt-4 max-w-md leading-7 text-stone-300">
            Watch the official 1.0 release trailer, then use the guides above to turn the chaos into
            a build you can repeat.
          </p><a
            class="btn-outline mt-6 inline-flex border-orange-600 bg-black/20"
            href="#trailer"
            target="_blank"
            rel="noreferrer">Open on YouTube →</a
          >
        </div><div class="video-frame">
          <iframe
            src="about:blank"
            title="Official game trailer"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>
    <section class="site-shell section-home">
      <div class="fact-grid">
        <a href="/achievements" class="fact-card"
          ><p class="data text-xs text-orange-400">COMPLETION TRACK</p><strong class="display"
            >141</strong
          ><span>Steam Achievements</span><small>Keep these separate from Torments.</small></a
        ><a href="/achievements" class="fact-card"
          ><p class="data text-xs text-orange-400">MASTERY TRACK</p><strong class="display"
            >28</strong
          ><span>Torments</span><small>High-pressure challenges, not achievements.</small></a
        ><a href="/release-price" class="fact-card"
          ><p class="data text-xs text-orange-400">PLAY NOW</p><strong class="display"
            >$14.99</strong
          ><span>Current standard price</span><small
            >Steam, PlayStation and Xbox launch details.</small
          ></a
        >
      </div>
    </section>
    <section class="site-shell section-home home-faq">
      <div class="section-heading">
        <div>
          <p class="data text-xs tracking-[.25em] text-orange-400">QUICK ANSWERS</p><h2
            class="display mt-2 text-4xl font-bold text-white md:text-5xl"
          >
            Before you start.
          </h2>
        </div><a href="/faq" class="text-sm text-orange-300">Open all FAQs →</a>
      </div><div class="faq-grid">
        <details open>
          <summary>Is This Game multiplayer?</summary><p>
            No. The current game is single-player. The three-person squad is made from Survivors
            recruited during your run, not online players.
          </p>
        </details><details>
          <summary>How many Survivors are there?</summary><p>
            The current roster has 9 Survivors: Vanguard, Bulwark, Tactician, Stalker, Phantom,
            Field Medic, Incinerator, Gadgeteer and Scout.
          </p>
        </details><details>
          <summary>What did 1.0 add?</summary><p>
            Version 1.0 adds Scout, Contaminated Zone, Gauntlet, a hub, story missions,
            relationships and additional progression content.
          </p>
        </details><details>
          <summary>Are Achievements and Torments the same?</summary><p>
            No. There are 141 Steam Achievements and 28 separate Torments. Torments are
            high-pressure challenges and should be tracked separately.
          </p>
        </details>
      </div>
    </section>
  </main>
  <footer class="home-footer">
    <div class="site-shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:py-16">
      <div>
        <a href="/" class="display text-lg font-bold tracking-[.16em] text-orange-200"
          >GAME <span class="text-red-500">//</span> FIELD MANUAL</a
        ><p class="mt-4 max-w-sm text-sm leading-6 text-stone-400">
          A fan-made This Game field guide for first clears, squad builds, secrets, maps and
          completion routes.
        </p><p class="data mt-5 text-[10px] uppercase tracking-wider text-stone-500">
          Not affiliated with Game Publisher.
        </p>
      </div><div>
        <p class="data text-[10px] tracking-[.2em] text-orange-400">EXPLORE</p><div
          class="mt-4 flex flex-col gap-3 text-sm text-stone-300"
        >
          <a href="/beginner-guide">Beginner Guide</a><a href="/characters">Survivors</a><a
            href="/weapons">Weapons</a
          ><a href="/items">Items</a><a href="/synergies">Builds & Synergies</a>
        </div>
      </div><div>
        <p class="data text-[10px] tracking-[.2em] text-orange-400">WORLD & CLEAR</p><div
          class="mt-4 flex flex-col gap-3 text-sm text-stone-300"
        >
          <a href="/maps">Maps & Gauntlet</a><a href="/achievements">Achievements / Torments</a><a
            href="/potato">Secret Item Secret</a
          ><a href="/curly-little-potato">Curly Little Secret Item</a><a href="/release-price"
            >Release & Price</a
          >
        </div>
      </div><div>
        <p class="data text-[10px] tracking-[.2em] text-orange-400">OFFICIAL + STEAM</p><div
          class="mt-4 flex flex-col gap-3 text-sm text-stone-300"
        >
          <a href="https://example-game.invalid/" target="_blank" rel="noreferrer"
            >Official Website ↗</a
          ><a href="https://store.steampowered.com" target="_blank" rel="noreferrer"
            >Steam Store ↗</a
          ><a href="/privacy-policy">Privacy Policy</a><a href="/terms-of-service"
            >Terms of Service</a
          >
        </div>
      </div>
    </div><div class="home-footer-bottom">
      <div
        class="site-shell flex flex-col gap-2 py-4 text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between"
      >
        <span>© 2026 GAME Field Manual</span><span class="data uppercase tracking-wider"
          >English guide / Version 1.0</span
        >
      </div>
    </div>
  </footer>
</BaseLayout>
