---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { articles } from '~/data/articles';
const title='Zombie Combat Field Manual';
const description='Reusable survivor-like zombie combat guide template for builds, characters, weapons, maps and completion.';
---
<BaseLayout {title} {description} locale="en"><header class="home-nav"><div class="site-shell flex min-h-16 items-center justify-between"><a href="/" class="display text-sm font-bold tracking-widest text-orange-200">COMBAT // FIELD MANUAL</a><nav class="hidden gap-5 text-xs uppercase tracking-widest text-stone-300 md:flex"><a href="/beginner-guide">Start Here</a><a href="/characters">Characters</a><a href="/weapons">Weapons</a><a href="/maps">Maps</a></nav><details class="language-menu"><summary class="data cursor-pointer list-none text-xs tracking-widest text-orange-300">English ▾</summary><div class="language-popover"><a href="/">EN</a><a href="/ru/">RU</a><a href="/de/">DE</a><a href="/ja/">JA</a></div></details></div></header><main><section class="hero-home"><div class="hero-shade"></div><div class="site-shell relative flex min-h-[calc(100vh-4rem)] items-end pb-20 pt-24"><div class="max-w-3xl"><p class="data text-xs tracking-[.3em] text-orange-300">REUSABLE ZOMBIE COMBAT WIKI TEMPLATE</p><h1 class="display mt-5 text-5xl font-extrabold uppercase leading-[.9] text-white sm:text-7xl">Survive the<br/><span class="text-red-500">Horde</span></h1><p class="mt-7 max-w-2xl text-xl leading-8 text-stone-200">Swap in your game data, images and official links. Navigation, article layout, multilingual routes and SEO plumbing are ready for a combat-focused guide site.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/beginner-guide" class="btn-primary">Open starter guide</a><a href="#guides" class="btn-outline border-orange-500/70 bg-black/30 text-white">Browse modules</a></div></div></div></section><section id="guides" class="site-shell section-home"><div class="section-heading"><div><p class="data text-xs tracking-[.25em] text-orange-400">MODULES</p><h2 class="display mt-2 text-4xl font-bold text-white">Build your game guide.</h2></div><p class="max-w-md text-stone-400">Each module is a focused player answer with conditions, actions and results.</p></div><div class="start-grid">{articles.map((article)=><a class="media-card" href={`/${article.slug}`}><span class="media-card-shade"></span><div class="relative"><p class="data text-[10px] tracking-[.2em] text-orange-300">{article.slug.toUpperCase()}</p><h3 class="display mt-2 text-2xl font-bold text-white">{article.title}</h3><p class="mt-2 max-w-xs text-sm leading-6 text-stone-200">{article.intro}</p><span class="mt-5 inline-block text-xs uppercase tracking-widest text-orange-300">Open guide →</span></div></a>)}</div></section></main><footer class="home-footer"><div class="site-shell py-10 text-sm text-stone-400">Replace this footer with your game name, official site and store links.</div></footer></BaseLayout>
